#!/usr/bin/env bash
# 拦截向外部（公网）远程推送敏感目录：docs/、iflytek/aiyun/（私有化部署、脚本、profile、prompts）。
# 启用：git config core.hooksPath .githooks
# 内部远程判定：URL 含 INTERNAL_HOSTS 中任一主机（默认 git.iflytek.com）。其余远程都按外部处理。
# 只检查新增/修改/重命名/复制/类型变更（--diff-filter=ACMRT）；纯删除敏感文件不算命中（删除不会泄露内容）。
# 敏感路径可用 AGD_SENSITIVE_PATHS（扩展正则）覆盖。
set -euo pipefail
remote_name=$1 remote_url=$2
INTERNAL_HOSTS=${AGD_INTERNAL_HOSTS:-git.iflytek.com}
SENSITIVE=${AGD_SENSITIVE_PATHS:-'^(docs/|iflytek/aiyun/)'}
for host in $INTERNAL_HOSTS; do case "$remote_url" in *"$host"*) exit 0 ;; esac; done
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # 删除远程分支，不涉及内容
  if [ "$remote_sha" = "$zero" ]; then range=$(git rev-list "$local_sha" --not --remotes="$remote_name")
  else range=$(git rev-list "$remote_sha..$local_sha"); fi
  [ -n "$range" ] || continue
  hits=$(for c in $range; do git diff-tree --no-commit-id --name-only -r --root --diff-filter=ACMRT "$c"; done | grep -E "$SENSITIVE" | sort -u || true)
  if [ -n "$hits" ]; then
    echo "pre-push: 拒绝向外部远程 ${remote_name} (${remote_url}) 推送 ${local_ref} → ${remote_ref}，以下敏感路径有改动：" >&2
    echo "$hits" | sed 's/^/  /' >&2
    status=1
  fi
done
[ $status = 0 ] || echo "pre-push: 请改用过滤掉敏感目录的对外分支（如 public/main）再推送。" >&2
exit $status
