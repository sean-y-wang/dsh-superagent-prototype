# RDG portal dsh-superagent watchdog — install on the intranet host (crontab -e).
# Phase-1 default: ONE stateDir. Adjust paths and hook URL as needed.
#
# Docs: docs/011-rdg-portal-ops.md

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# Every 30 minutes: scan the single-instance stateDir; print JSON to a log (or POST --hook-url).
*/30 * * * *  /usr/bin/python3 /opt/cloud-agent-dispatch/scripts/rdg-portal-watchdog.py \
  --state-dir /var/dsh/rdg-portal \
  --stale-hours 24 \
  --json \
  >> /var/log/dsh-portal-watchdog.jsonl 2>&1

# Optional: notify a webhook (Feishu bot adapter / internal relay).
# */30 * * * *  /usr/bin/python3 /opt/cloud-agent-dispatch/scripts/rdg-portal-watchdog.py \
#   --state-dir /var/dsh/rdg-portal \
#   --stale-hours 24 \
#   --hook-url http://127.0.0.1:8090/hooks/dsh-watchdog

# Optional: notify DEV owner on i讯飞 when findings exist (星辰测试 bot).
# */30 * * * *  /usr/bin/python3 /opt/cloud-agent-dispatch/scripts/rdg-portal-watchdog.py \
#   --state-dir /var/dsh/rdg-portal \
#   --stale-hours 24 \
#   --json \
#   | /opt/cloud-agent-dispatch/scripts/rdg-portal-watchdog-ixunfei.sh

# Legacy five-instance scan (only if you still run per-repo profiles):
# */30 * * * *  /usr/bin/python3 /opt/cloud-agent-dispatch/scripts/rdg-portal-watchdog.py \
#   --state-dir /var/dsh/aihub-site \
#   --state-dir /var/dsh/rdg-promotion-console \
#   --state-dir /var/dsh/aihub-doc \
#   --state-dir /var/dsh/aihub-service \
#   --state-dir /var/dsh/aihub-admin \
#   --stale-hours 24 --json >> /var/log/dsh-portal-watchdog.jsonl 2>&1
