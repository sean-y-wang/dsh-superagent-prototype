[Unit]
Description=dsh-superagent RDG portal (single-instance multi-repo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/opt/cloud-agent-dispatch
Environment=HOME=/var/dsh
Environment=DSH_SUPERAGENT_PROFILE=rdg-portal
# Wrappers inject GITLAB_TOKEN / AIHUB_INTERNAL_SECRET / LARKSUITE_CLI_* — do not put secrets here.
EnvironmentFile=-/etc/dsh/rdg-portal.env
ExecStart=/opt/cloud-agent-dispatch/scripts/dsh-superagent start --profile rdg-portal --foreground
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
